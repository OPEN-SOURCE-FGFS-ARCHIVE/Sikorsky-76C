<?xml version="1.0"?>

<PropertyList>
	
	
<animation>
        <type>range</type>
        <min-m>0</min-m>
        <max-m>500</max-m>
    </animation>

<model>
		<name>Pylons</name>
		<path>Aircraft/Sikorsky-76C/Models/payload/pylons.xml</path>
		<offsets>
			<x-m>0</x-m>
			<y-m>0</y-m>
			<z-m>0</z-m>
			<pitch-deg>0.0</pitch-deg>
		</offsets>
	</model>	


  <model>
		<name>none</name>
		<path>Aircraft/Sikorsky-76C/Models/payload/basic.xml</path>
		<offsets>
			<x-m>5.85</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>-0.35 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>none</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>none</value>
        </equals>
       
    </condition>
  </animation>		

  <model>
		<name>Executive</name>
		<path>Aircraft/Sikorsky-76C/Models/payload/exec.xml</path>
		<offsets>
			<x-m>5.85</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>-0.35 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Executive</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Executive</value>
        </equals>
       
    </condition>
  </animation>	




  <model>
		<name>Passenger</name>
		<path>Aircraft/Sikorsky-76C/Models/payload/passenger.xml</path>
		<offsets>
			<x-m>4.85</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>-1.01 </z-m>
			<pitch-deg>0</pitch-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Passenger</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Passenger</value>
        </equals>
       
    </condition>
  </animation>	


  <model>
		<name>SAR</name>
		<path>Aircraft/Sikorsky-76C/Models/payload/sar.xml</path>
		<offsets>
			<x-m>5</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>-0.7 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>SAR</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>SAR</value>
        </equals>
       
    </condition>
  </animation>


  
  <model>
		<name>Medivac</name>
		<path>Aircraft/Sikorsky-76C/Models/payload/medivac.xml</path>
		<offsets>
			<x-m>5</x-m>
            <y-m>  0.00000 </y-m>
            <z-m>-0.74 </z-m>
			<pitch-deg>0</pitch-deg>
			<heading-deg>0</heading-deg>
		</offsets>
	</model>
  <animation>
    <type>select</type>
    <object-name>Medivac</object-name>      
    <condition>
     
        <equals>
          <property>sim/multiplay/generic/string[1]</property>
          <value>Medivac</value>
        </equals>
       
    </condition>
  </animation>

  
  <animation>
  <type>select</type>
  <object-name>pylon.C</object-name>  
  <condition>
  <or>
     <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Medivac</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>none</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>SAR</value>
   </equals>
   <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Passenger</value>
   </equals>
  <equals>
    <property>sim/multiplay/generic/string[1]</property>
    <value>Executive</value>
   </equals>
   
   
  </or>
  </condition>
 </animation>

</PropertyList>
