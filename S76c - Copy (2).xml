length="1.40" chord="1.0" sweep="0" idrag="0">
  <stall aoa="15" width="3" peak="1.5"/>
</mstab>-->



<gear x="3.458" y="0.00" z="-2.879" compression="0.4" retract-time="4" 
     initial-load="0.8" spring="2">
    <control-input axis="/controls/flight/rudder" control="STEER" 
                 src0="-1.0" dst0="-1.0"
                  src1="1.0" dst1="1.0"/>
    <control-output control="STEER" prop="controls/gear/steering"/>
    <control-input axis="/controls/gear/gear-down" control="EXTEND"/>
    <control-speed control="EXTEND" transition-time="4"/>
    <control-output control="EXTEND" prop="/gear/gear[0]/position-norm"/>
  </gear>
  
  <gear x="-1.366" y="1.1" z="-2.920" compression="0.5" retract-time="4"
     initial-load="0.5" spring="2">
    <control-input axis="/controls/gear/brake-left" control="BRAKE"/>
    <control-input axis="/controls/gear/brake-parking" control="BRAKE"/>
    <control-input axis="/controls/gear/gear-down" control="EXTEND"/>
    <control-speed control="EXTEND" transition-time="4"/>
    <control-output control="EXTEND" prop="/gear/gear[1]/position-norm"/>
  </gear>
  
  <gear x="-1.366" y="-1.1" z="-2.920" compression="0.5" retract-time="3.95"  initial-load="0.5" spring="2">
    <control-input axis="/controls/gear/brake-right" control="BRAKE"/>
    <control-input axis="/controls/gear/brake-parking" control="BRAKE"/>
    <control-input axis="/controls/gear/gear-down" control="EXTEND"/>
    <control-speed control="EXTEND" transition-time="3.95"/>
    <control-output control="EXTEND" prop="/gear/gear[2]/position-norm"/>
  </gear>


<!--<tank x="0" y="0" z="-1.8" capacity="1800" jet="true"/>-->


<tank x="0" y="0" z="-1.8" capacity="1600"/> <!-- main @ 6.682 ppg (H3EU.pdf) -->
<tank x="0" y="0" z="-1.4" capacity="200"/> <!-- supply -->


<weight x="2.0" y="0.5"  z="-1.3" mass-prop="/sim/weight[0]/weight-lb"/><!-- pilot -->
<weight x="2.0" y="-0.5" z="-1.3" mass-prop="/sim/weight[1]/weight-lb"/><!-- co pilot -->
<weight x="0.8" y="0.0" z="-1.3" mass-prop="/sim/weight[2]/weight-lb"/><!-- passengers -->
<weight x="0.0" y="0.0" z="0" mass-prop="/sim/weight[3]/weight-lb"/><!-- not used -->
<weight x="0.0" y="0.0" z="0" mass-prop="/sim/weight[4]/weight-lb"/><!-- not used -->
<weight x="0.0" y="0.0" z="-2.0" mass-prop="/sim/weight[5]/weight-lb"/><!-- configuration -->

<ballast x="3.458" y="0.00" z="-2.879" mass="1600"/>
<ballast x="-1.366" y="1.1" z="-2.920" mass="1000"/>
<ballast x="-1.366" y="-1.1" z="-2.920" mass="1000"/>

<hitch name="aerotow" x="0.0" y="0" z="-2.5"  force-is-calculated-by-other="1">
  <tow length="100" weight-per-meter="0.035" elastic-constant="8000" break-force="10000" mp-auto-connect-period="1.0"/>
  <winch max-tow-length="1000" min-tow-length="100" initial-tow-length="100"/>
</hitch>

<thruster  x="0.0" y="0.0" z="0.2" vx="1" vy="0" vz="0" thrust="4000">
  <control-input axis="/rotors/main/vibration/longitudinal" src0="-1" src1="1" dst0="-1" dst1="1" control="THROTTLE"/>
</thruster>

<thruster  x="0.0" y="0.0" z="0.2" vx="0" vy="1" vz="0" thrust="4000">
  <control-input axis="/rotors/main/vibration/lateral" src0="-1" src1="1" dst0="-1" dst1="1" control="THROTTLE"/>
</thruster>

</airplane>
