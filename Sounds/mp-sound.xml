		</starter>
	
<engine>
			<name>exhaust0-start</name>
			<mode>once</mode>
			<path>Sounds/exhaust_start.wav</path>
				<condition>
			<and>
				<property>engines/engine[0]/running</property>
				<not>
						<property>sim/current-view/internal</property>
					</not>
					</and>
			</condition>
			<volume>
				<factor>0.02</factor>
			</volume>
			<volume>
				<property>sim/model/bo105/sound/volume</property>
				<factor>10</factor>
			</volume>
			<reference-dist>50</reference-dist>
			<max-dist>200</max-dist>
		</engine>

		<engine>
			<name>exhaust0-loop</name>
			<mode>looped</mode>
			<path>Sounds/exhaust_loop.wav</path>
			<condition>
			<and>
				<property>engines/engine[0]/running</property>
				<not>
						<property>sim/current-view/internal</property>
					</not>
					</and>
			</condition>
			<delay-sec>11.5</delay-sec>
			<volume>
				<factor>0.02</factor>
			</volume>
			<volume>
				<property>sim/model/bo105/sound/volume</property>
				<factor>10</factor>
			</volume>
			<reference-dist>50</reference-dist>
			<max-dist>200</max-dist>
		</engine>

		<engine>
			<name>exhaust0-shutdown</name>
			<mode>once</mode>
			<path>Sounds/exhaust_shutdown.wav</path>
				<condition>
			<and>
				<property>engines/engine[0]/running</property>
				<not>
						<property>sim/current-view/internal</property>
					</not>
					</and>
			</condition>
			<volume>
				<factor>0.02</factor>
			</volume>
			<volume>
				<property>sim/model/bo105/sound/volume</property>
				<factor>10</factor>
			</volume>
			<reference-dist>50</reference-dist>
