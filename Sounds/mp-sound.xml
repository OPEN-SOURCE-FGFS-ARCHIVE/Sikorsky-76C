		<starter>
			<name>starter1_stop</name>
			<mode>once</mode>
			<path>Aircraft/Sikorsky-76C/Sounds/starter_stop.wav</path>
			<condition>
				<not>
					<property>controls/engines/engine[1]/starter</property>
				</not>
			</condition>
